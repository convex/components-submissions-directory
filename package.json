{
  "name": "flex-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "vite --open",
    "dev:backend": "convex dev",
    "build": "vite build",
    "lint": "tsc -p convex -noEmit --pretty false && tsc -b --pretty false && convex dev --once && vite build",
    "lint:eslint": "eslint .",
    "lint:convex": "eslint \"convex/**/*.ts\"",
    "deploy:backend": "npx convex deploy"
  },
