    "@pierre/diffs": "^1.1.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@resvg/resvg-wasm": "^2.6.2",
    "clsx": "^2.1.1",
    "convex": "^1.46.0",
    "convex-helpers": "^0.1.128",
    "jimp": "^1.6.0",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "openai": "^6.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.6",
    "rehype-raw": "^7.0.0",
