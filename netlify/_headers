# Response headers for the Netlify deploy. vite.config.ts copies this file to
# the publish root (dist/_headers), which is where Netlify reads it from.
#
# Keep header rules here, not in netlify.toml: on this site Netlify ignores
# [[headers]] (and [[redirects]]) in netlify.toml. Every deploy reported "No
# header rules processed" and hashed assets were served with max-age=0.
#
# Headers only apply to files Netlify serves from its own store, not to
# responses from an edge function, so og-meta excludes assets and fonts.

# Hashed build assets are content-addressed, safe to cache forever
/components/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts are not content-hashed: cache for a week and revalidate in the
# background, so an in-place font swap propagates within a week
/components/fonts/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Logos, social icons and favicons at the root of public/, linked from
# index.html, the header and footer. They are not content-hashed, so cache
# for a day rather than forever. stale-while-revalidate lets a visitor back
# within the week use the cached copy while it refreshes in the background,
# so a changed logo shows up within a day, or one visit later inside the
# week. Before this every visit revalidated them (max-age=0). Listed one by
# one: /components/* would also match the HTML routes, and a wildcard like
# /components/*.png could also match hashed images under assets/, where
# Netlify would merge both Cache-Control rules into one broken header.
# A new icon needs a rule here; og-meta's excludedPath globs in netlify.toml
# already let it through
/components/favicon.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/components/favicon-16x16.png
